---
import Layout from "../components/Layout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

// Import images
import heroImage from "../assets/hero.png";
import logoImage from "../assets/logo.svg";
import patternImage from "../assets/pattern.svg";
import footerImage from "../assets/foter.svg";

// Get all sections and sort by order
const sections = await getCollection("sections");
const sortedSections = sections.sort((a, b) => a.data.order - b.data.order);

// Get specific sections for easy access
const heroSection = sortedSections.find(s => s.id === "hero.mdx");
const aboutSection = sortedSections.find(s => s.id === "about.mdx");
const methodSection = sortedSections.find(s => s.id === "method.mdx");
const ctaSection = sortedSections.find(s => s.id === "cta.mdx");

// Render the content
const { Content: AboutContent } = aboutSection ? await aboutSection.render() : { Content: null };
const { Content: MethodContent } = methodSection ? await methodSection.render() : { Content: null };
const { Content: CtaContent } = ctaSection ? await ctaSection.render() : { Content: null };
---

<Layout
    title="Salam Wellbeing - Personalized & Gentle Fitness for Women in Toronto"
>
    <main>
        <!-- Hero Section - Full Bleed with Pattern on Top -->
        <section class="hero">
            <Image
                src={heroImage}
                alt="Fitness studio"
                class="hero-image"
                loading="eager"
            />

            <!-- Pattern and Arabic overlay at top -->
            <div class="pattern-overlay">
                <div class="pattern-left"></div>
                <div class="arabic-text">
                    {heroSection?.data.arabicText}
                </div>
                <div class="pattern-right"></div>
            </div>

            <!-- Hero content overlay -->
            <div class="hero-overlay">
                <Image
                    src={logoImage}
                    alt="Salam Wellbeing"
                    class="logo"
                    loading="eager"
                />
                <h1>
                    Personalized & <span class="gentle">Gentle</span><br
                    />Fitness for Women in Toronto
                </h1>
                <h1 class="hero-subtext">Finally.</h1>
                <div class="button-wrapper">
                    <button class="cta-button">{heroSection?.data.ctaButtonText}</button>
                </div>
            </div>
        </section>

        <!-- About Section -->
        {aboutSection && AboutContent && (
            <section class="content-section">
                <div class="section-title">
                    <div class="title-pattern-left"></div>
                    <h2>{aboutSection.data.title}</h2>
                    <div class="title-pattern-right"></div>
                </div>
                <div class="body-text">
                    <AboutContent />
                </div>
            </section>
        )}

        <!-- Method Section -->
        {methodSection && MethodContent && (
            <section class="content-section">
                <div class="section-title">
                    <div class="title-pattern-left"></div>
                    <h2>{methodSection.data.title}</h2>
                    <div class="title-pattern-right"></div>
                </div>
                <div class="body-text">
                    <MethodContent />
                </div>
            </section>
        )}

        <!-- CTA Section -->
        {ctaSection && CtaContent && (
            <section class="content-section cta-spacing">
                <div class="section-title">
                    <div class="title-pattern-left"></div>
                    <h2>{ctaSection.data.title}</h2>
                    <div class="title-pattern-right"></div>
                </div>
                <div class="body-text">
                    <CtaContent />
                </div>
                <div class="button-center">
                    <div class="button-wrapper">
                        <div class="button-pattern-bg"></div>
                        <button class="cta-button">{ctaSection.data.ctaButtonText}</button>
                    </div>
                </div>
            </section>
        )}

        <!-- Footer -->
        <footer class="footer">
            <Image src={footerImage} alt="Salam" class="footer-logo" />
        </footer>
    </main>
</Layout>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Tenor+Sans&family=Nunito:wght@200&display=swap");

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    main {
        font-family: "Tenor Sans", serif;
        background: radial-gradient(
            ellipse at bottom,
            #ffffff 0%,
            #fdc9a4 100%
        );
        min-height: 100vh;
    }

    /* Hero Section - Full Bleed */
    .hero {
        position: relative;
        width: 100%;
        margin: 0;
        padding: 0;
    }

    .hero-image {
        width: 100%;
        height: 90vh;
        display: block;
        transform: scaleX(-1);
        object-fit: cover;
        object-position: bottom center;
    }

    @media (max-width: 900px) {
        .hero-image {
            height: 80vh;
        }
    }

    @media (max-width: 600px) {
        .hero-image {
            height: 70vh;
            object-position: bottom left;
        }
    }

    /* Pattern overlay at top of hero */
    .pattern-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 5;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1rem 0;
    }

    @media (max-width: 900px) {
        .pattern-overlay {
            gap: 1rem;
            padding: 0.75rem 0;
        }
    }

    @media (max-width: 600px) {
        .pattern-overlay {
            gap: 0.5rem;
            padding: 0.5rem 0;
        }
    }

    .pattern-left,
    .pattern-right {
        flex: 1;
        height: 50px;
        background-repeat: repeat-x;
        background-size: auto 50px;
        background-position: center;
        opacity: 0.8;
        mix-blend-mode: color-dodge;
    }

    @media (max-width: 1200px) {
        .pattern-right {
            max-width: 350px;
        }
    }

    @media (max-width: 900px) {
        .pattern-right {
            max-width: 250px;
        }
    }

    @media (max-width: 600px) {
        .pattern-right {
            max-width: 180px;
        }
    }

    @media (max-width: 400px) {
        .pattern-right {
            max-width: 120px;
        }
    }

    .pattern-left {
        background-image: url("/assets/pattern.svg");
    }

    .pattern-right {
        background-image: url("/assets/pattern.svg");
    }

    @media (max-width: 1200px) {
        .pattern-right {
            max-width: 350px;
        }
    }

    @media (max-width: 900px) {
        .pattern-right {
            max-width: 250px;
        }
    }

    @media (max-width: 600px) {
        .pattern-right {
            max-width: 180px;
        }
    }

    @media (max-width: 400px) {
        .pattern-right {
            max-width: 120px;
        }
    }

    .arabic-text {
        color: #f6ffcd;
        font-size: 1.25rem;
        letter-spacing: -0.03em;
        white-space: nowrap;
        opacity: 0.9;
        mix-blend-mode: color-dodge;
        text-align: center;
        padding: 0 2rem;
        flex-shrink: 0;
    }

    @media (max-width: 900px) {
        .arabic-text {
            font-size: 1rem;
        }
    }

    @media (max-width: 600px) {
        .arabic-text {
            font-size: 0.875rem;
            letter-spacing: 0.15em;
        }
    }

    @media (max-width: 400px) {
        .arabic-text {
            font-size: 0.75rem;
        }
    }

    .hero-subtext {
        margin-top: 1em;
        margin-bottom: 1em;
        white-space: nowrap;
    }

    /* Hero content overlay */
    .hero-overlay {
        position: absolute;
        top: 20%;
        left: 6%;
        z-index: 10;
        max-width: 75%;
    }

    @media (max-width: 1200px) {
        .hero-overlay {
            max-width: 75%;
        }
    }

    @media (max-width: 900px) {
        .hero-overlay {
            max-width: 75%;
            top: 40%;
            left: 5%;
        }
    }

    @media (max-width: 600px) {
        .hero-overlay {
            max-width: 70%;
            top: 20%;
            left: 4%;
        }
    }

    .logo {
        width: 350px;
        height: auto;
        margin-bottom: 1rem;
        margin-left: 0;
        display: block;
    }

    @media (max-width: 1200px) {
        .logo {
            width: 240px;
        }
    }

    @media (max-width: 900px) {
        .logo {
            width: 200px;
            margin-bottom: 1.8rem;
        }
    }

    @media (max-width: 600px) {
        .logo {
            width: 160px;
        }
    }

    h1 {
        font-size: 3rem;
        font-weight: 400;
        line-height: 1.2;
        color: #f6ffcd;
        margin-bottom: 1rem;
        letter-spacing: -0.01em;
        text-align: left;
    }

    @media (max-width: 1200px) {
        h1 {
            font-size: 2.75rem;
        }
    }

    @media (max-width: 900px) {
        h1 {
            font-size: 2.2rem;
        }
    }

    @media (max-width: 600px) {
        h1 {
            font-size: 1.7rem;
            line-height: 1.25;
            margin-bottom: 0.5rem;
        }
    }

    @media (max-width: 400px) {
        h1 {
            font-size: 1.5rem;
        }
    }

    .gentle {
        font-family: "Nunito", sans-serif;
        font-weight: 200;
    }

    /* CTA Button with Pattern Border */
    .button-center {
        text-align: center;
        margin-top: 2rem;
    }

    .button-wrapper {
        position: relative;
        display: inline-block;
        padding: 0;
        background: transparent;
    }

    .cta-button {
        position: relative;
        z-index: 1;
        background: #f6543e;
        color: #ffffff;
        border: none;
        padding: 1.1rem 3rem;
        font-size: 1.2rem;
        font-family: "Tenor Sans", serif;
        cursor: pointer;
        transition: background 0.3s ease;
        letter-spacing: 0.03em;
        display: block;
        box-shadow:
            inset 0 0 0 8px #f6543e,
            inset 0 0 0 10px #f6ffcd;
    }

    @media (max-width: 600px) {
        .cta-button {
            padding: 0.875rem 2rem;
            font-size: 1rem;
        }
    }

    .cta-button:hover {
        background: #e54738;
    }

    /* Content Sections */
    .content-section {
        background: transparent;
        padding: 8rem 0;
        text-align: center;
    }

    @media (max-width: 900px) {
        .content-section {
            padding: 6rem 1.5rem;
        }
    }

    @media (max-width: 600px) {
        .content-section {
            padding: 5rem 1.5rem;
        }
    }

    .cta-spacing {
        padding-bottom: 10rem;
    }

    @media (max-width: 900px) {
        .cta-spacing {
            padding-bottom: 8rem;
        }
    }

    @media (max-width: 600px) {
        .cta-spacing {
            padding-bottom: 6rem;
        }
    }

    .section-title {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 2rem;
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
    }

    .title-pattern-left,
    .title-pattern-right {
        flex: 1;
        height: 50px;
        background-repeat: repeat-x;
        background-size: auto 50px;
        background-position: center;
        opacity: 0.8;
        mix-blend-mode: normal;
        filter: brightness(0) invert(1);
    }

    @media (max-width: 1200px) {
        .title-pattern-right {
            max-width: 350px;
        }
    }

    @media (max-width: 900px) {
        .title-pattern-right {
            max-width: 250px;
        }
    }

    @media (max-width: 600px) {
        .title-pattern-right {
            max-width: 180px;
        }
    }

    @media (max-width: 400px) {
        .title-pattern-right {
            max-width: 120px;
        }
    }

    .title-pattern-left {
        background-image: url("/assets/pattern.svg");
    }

    .title-pattern-right {
        background-image: url("/assets/pattern.svg");
    }

    @media (max-width: 1200px) {
        .title-pattern-right {
            max-width: 350px;
        }
    }

    @media (max-width: 900px) {
        .title-pattern-right {
            max-width: 250px;
        }
    }

    @media (max-width: 600px) {
        .title-pattern-right {
            max-width: 180px;
        }
    }

    @media (max-width: 400px) {
        .title-pattern-right {
            max-width: 120px;
        }
    }

    h2 {
        font-size: 2.5rem;
        font-weight: 400;
        letter-spacing: 0.03em;
        color: #171717;
        line-height: 1.5;
        margin: 0;
        white-space: nowrap;
        text-align: center;
        padding: 0 2rem;
        flex-shrink: 0;
    }

    @media (max-width: 1200px) {
        h2 {
            font-size: 2.25rem;
        }
    }

    @media (max-width: 900px) {
        h2 {
            font-size: 2rem;
        }
    }

    @media (max-width: 600px) {
        h2 {
            font-size: 1.75rem;
        }
    }

    @media (max-width: 400px) {
        h2 {
            font-size: 1.5rem;
        }
    }

    .subsection-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #171717;
        margin-top: 3rem;
        text-align: left;
        margin-left: auto;
        margin-right: auto;
        padding: 0 2rem;
        max-width: 800px;
    }

    .content-section .cta-button {
        margin-top: 1rem;
    }

    .body-text {
        font-size: 1.125rem;
        line-height: 1.8;
        color: #171717;
        margin-bottom: 2.5rem;
        letter-spacing: 0.01em;
        opacity: 0.9;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
        padding: 0 2rem;
        text-align: left;
    }

    @media (max-width: 900px) {
        .body-text {
            font-size: 1.0625rem;
        }
    }

    @media (max-width: 600px) {
        .body-text {
            font-size: 1rem;
            margin-bottom: 2rem;
        }
    }

    @media (max-width: 400px) {
        .body-text {
            font-size: 0.9375rem;
        }
    }

    .section-title + .body-text {
        margin-top: 5rem;
    }

    .subsection-title + .body-text {
        margin-top: 0;
    }

    /* MDX Content Styles */
    .body-text :global(h3) {
        font-size: 1.25rem;
        font-weight: 700;
        color: #171717;
        margin-top: 3rem;
        margin-bottom: 1rem;
        text-align: left;
    }

    .body-text :global(p) {
        margin-bottom: 1rem;
    }

    .body-text :global(p:last-child) {
        margin-bottom: 0;
    }

    .body-text :global(strong) {
        font-weight: 700;
    }

    .body-text :global(em) {
        font-style: italic;
    }

    .body-text :global(br) {
        display: block;
        content: "";
        margin-top: 0.5rem;
    }

    /* Footer */
    .footer {
        background: transparent;
        padding: 0;
        text-align: center;
    }

    .footer-logo {
        width: 100%;
        max-width: 600px;
        height: auto;
        margin: 0 auto;
        display: block;
        opacity: 0.8;
        mix-blend-mode: color-burn;
    }

    @media (max-width: 600px) {
        .footer-logo {
            max-width: 90%;
        }
    }
</style>
