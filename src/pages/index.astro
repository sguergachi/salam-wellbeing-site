---
import Layout from "../components/Layout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

// Import images
import heroImage from "../assets/hero.png";
import logoImage from "../assets/logo.svg";
import patternImage from "../assets/pattern.svg";
import footerImage from "../assets/foter.svg";

// Get all sections and sort by order
const sections = await getCollection("sections");
const sortedSections = sections.sort(
    (a: CollectionEntry<"sections">, b: CollectionEntry<"sections">) =>
        a.data.order - b.data.order,
);

// Type for rendered sections
type RenderedSection = CollectionEntry<"sections"> & {
    Content: any;
};

// Render all sections
const renderedSections: RenderedSection[] = await Promise.all(
    sortedSections.map(async (section: CollectionEntry<"sections">) => {
        const { Content } = await section.render();
        return {
            ...section,
            Content,
        };
    }),
);
---

<Layout
    title="Salam Wellbeing - Personalized & Gentle Fitness for Women in Toronto"
>
    <main>
        {
            renderedSections.map((section: RenderedSection) => {
                const { data, Content } = section;

                if (data.template === "hero") {
                    return (
                        <section class="hero">
                            <Image
                                src={heroImage}
                                alt="Fitness studio"
                                class="hero-image"
                                loading="eager"
                            />

                            <div class="pattern-overlay">
                                <div class="pattern-left" />
                                <div class="arabic-text">{data.arabicText}</div>
                                <div class="pattern-right" />
                            </div>

                            <div class="hero-overlay">
                                <Image
                                    src={logoImage}
                                    alt="Salam Wellbeing"
                                    class="logo"
                                    loading="eager"
                                />
                                <h1>
                                    Personalized &{" "}
                                    <>
                                        <span class="gentle">Gentle</span>
                                        <br />
                                    </>
                                    Fitness for Women in Toronto
                                </h1>
                                <h1 class="hero-subtext">Finally.</h1>
                                <div class="button-wrapper">
                                    <a href={data.ctaButtonLink} class="cta-button">
                                        {data.ctaButtonText}
                                    </a>
                                </div>
                            </div>
                        </section>
                    );
                } else if (data.template === "cta") {
                    return (
                        <section class="content-section cta-spacing">
                            <div class="section-title">
                                <div class="title-pattern-left" />
                                <h2>{data.title}</h2>
                                <div class="title-pattern-right" />
                            </div>
                            <div class="body-text">
                                <Content />
                            </div>
                            <div class="button-center">
                                <div class="button-wrapper">
                                    <div class="button-pattern-bg" />
                                    <a href={data.ctaButtonLink} class="cta-button">
                                        {data.ctaButtonText}
                                    </a>
                                </div>
                            </div>
                        </section>
                    );
                } else {
                    return (
                        <section class="content-section">
                            <div class="section-title">
                                <div class="title-pattern-left" />
                                <h2>{data.title}</h2>
                                <div class="title-pattern-right" />
                            </div>
                            <div class="body-text">
                                <Content />
                            </div>
                        </section>
                    );
                }
            })
        }

        <!-- Footer -->
        <footer class="footer">
            <Image src={footerImage} alt="Salam" class="footer-logo" />
        </footer>
    </main>
</Layout>

<style>
    /* Improved typography:
       - Use a readable sans for body text (Inter) and Tenor Sans for display headings.
       - Use CSS variables and responsive sizes with clamp() for better scaling.
       - Increase line-height and adjust letter-spacing for better legibility.
    */

    @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Nunito:wght@200;400;700&family=Tenor+Sans&display=swap");

    :root {
        --font-sans: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif;
        --font-display: "Tenor Sans", Georgia, "Times New Roman", serif;
        --font-accent: "Nunito", var(--font-sans);

        --color-text: #171717;
        --color-muted: rgba(23, 23, 23, 0.9);

        --fs-base: 1rem; /* 16px */
        --leading-base: 1.6;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    main {
        font-family: var(--font-sans);
        font-size: var(--fs-base);
        line-height: var(--leading-base);
        color: var(--color-text);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        background: radial-gradient(
            ellipse at bottom,
            #ffffff 0%,
            #fdc9a4 100%
        );
        min-height: 100vh;
    }

    /* Hero Section - Full Bleed */
    .hero {
        position: relative;
        width: 100%;
        margin: 0;
        padding: 0;
    }

    .hero-image {
        width: 100%;
        height: 90vh;
        display: block;
        transform: scaleX(-1);
        object-fit: cover;
        object-position: bottom center;
    }

    @media (max-width: 900px) {
        .hero-image {
            height: 80vh;
        }
    }

    @media (max-width: 600px) {
        .hero-image {
            height: 70vh;
            object-position: bottom left;
        }
    }

    /* Pattern overlay at top of hero */
    .pattern-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 5;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1rem 0;
    }

    @media (max-width: 900px) {
        .pattern-overlay {
            gap: 1rem;
            padding: 0.75rem 0;
        }
    }

    @media (max-width: 600px) {
        .pattern-overlay {
            gap: 0.5rem;
            padding: 0.5rem 0;
        }
    }

    .pattern-left,
    .pattern-right {
        flex: 1;
        height: 50px;
        background-repeat: repeat-x;
        background-size: auto 50px;
        background-position: center;
        opacity: 0.8;
        mix-blend-mode: color-dodge;
    }

    .pattern-left {
        background-image: url("/assets/pattern.svg");
    }

    .pattern-right {
        background-image: url("/assets/pattern.svg");
    }

    .arabic-text {
        color: #f6ffcd;
        font-size: 1.25rem;
        letter-spacing: normal; /* Arabic scripts generally look better without negative tracking */
        white-space: nowrap;
        opacity: 0.95;
        mix-blend-mode: color-dodge;
        text-align: center;
        padding: 0 2rem;
        flex-shrink: 0;
    }

    @media (max-width: 900px) {
        .arabic-text {
            font-size: 1rem;
        }
    }

    @media (max-width: 600px) {
        .arabic-text {
            font-size: 0.875rem;
            letter-spacing: 0.15em;
        }
    }

    @media (max-width: 400px) {
        .arabic-text {
            font-size: 0.75rem;
        }
    }

    .hero-subtext {
        margin-top: 1em;
        margin-bottom: 1em;
        white-space: nowrap;
        font-weight: 600;
    }

    /* Hero content overlay */
    .hero-overlay {
        position: absolute;
        top: 20%;
        left: 6%;
        z-index: 10;
        max-width: 75%;
    }

    @media (max-width: 1200px) {
        .hero-overlay {
            max-width: 75%;
        }
    }

    @media (max-width: 900px) {
        .hero-overlay {
            max-width: 75%;
            top: 40%;
            left: 5%;
        }
    }

    @media (max-width: 600px) {
        .hero-overlay {
            max-width: 70%;
            top: 20%;
            left: 4%;
        }
    }

    .logo {
        width: 350px;
        height: auto;
        margin-bottom: 1rem;
        margin-left: 0;
        display: block;
    }

    @media (max-width: 1200px) {
        .logo {
            width: 240px;
        }
    }

    @media (max-width: 900px) {
        .logo {
            width: 200px;
            margin-bottom: 1.8rem;
        }
    }

    @media (max-width: 600px) {
        .logo {
            width: 160px;
        }
    }

    h1 {
        /* Use clamp for responsive scaling and Tenor Sans for display */
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.5rem, 2.2vw + 1.2rem, 3rem);
        line-height: 1.15;
        color: #f6ffcd;
        margin-bottom: 1rem;
        letter-spacing: -0.01em;
        text-align: left;
    }

    @media (max-width: 600px) {
        h1 {
            margin-bottom: 0.5rem;
        }
    }

    .gentle {
        font-family: var(--font-accent);
        font-weight: 600; /* give the word Gentle a slightly stronger weight for emphasis */
        font-style: normal;
    }

    /* CTA Button with Pattern Border */
    .button-center {
        text-align: center;
        margin-top: 2rem;
    }

    .button-wrapper {
        position: relative;
        display: inline-block;
        padding: 0;
        background: transparent;
    }

    .cta-button {
        position: relative;
        z-index: 1;
        background: #f6543e;
        color: #ffffff;
        border: none;
        padding: 1.1rem 3rem;
        font-size: 1.1rem;
        font-family: var(--font-display);
        font-weight: 400;
        cursor: pointer;
        transition: background 0.3s ease;
        letter-spacing: 0.02em;
        display: inline-block;
        box-shadow:
            inset 0 0 0 8px #f6543e,
            inset 0 0 0 10px #f6ffcd;
        text-decoration: none;
    }

    @media (max-width: 600px) {
        .cta-button {
            padding: 0.875rem 2rem;
            font-size: 1rem;
        }
    }

    .cta-button:hover {
        background: #e54738;
    }

    /* Content Sections */
    .content-section {
        background: transparent;
        padding: 8rem 0;
        text-align: center;
    }

    @media (max-width: 900px) {
        .content-section {
            padding: 6rem 1.5rem;
        }
    }

    @media (max-width: 600px) {
        .content-section {
            padding: 5rem 1.5rem;
        }
    }

    .cta-spacing {
        padding-bottom: 10rem;
    }

    @media (max-width: 900px) {
        .cta-spacing {
            padding-bottom: 8rem;
        }
    }

    @media (max-width: 600px) {
        .cta-spacing {
            padding-bottom: 6rem;
        }
    }

    .section-title {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 2rem;
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
    }

    .title-pattern-left,
    .title-pattern-right {
        flex: 1;
        height: 50px;
        background-repeat: repeat-x;
        background-size: auto 50px;
        background-position: center;
        opacity: 0.8;
        mix-blend-mode: normal;
        filter: brightness(0) invert(1);
    }

    .title-pattern-left {
        background-image: url("/assets/pattern.svg");
    }

    .title-pattern-right {
        background-image: url("/assets/pattern.svg");
    }

    h2 {
        font-family: var(--font-display);
        font-size: clamp(1.5rem, 1.6vw + 1.1rem, 2.5rem);
        font-weight: 400;
        letter-spacing: 0.02em;
        color: var(--color-text);
        line-height: 1.25;
        margin: 0;
        white-space: nowrap;
        text-align: center;
        padding: 0 2rem;
        flex-shrink: 0;
    }

    .subsection-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-text);
        margin-top: 3rem;
        text-align: left;
        margin-left: auto;
        margin-right: auto;
        padding: 0 2rem;
        max-width: 800px;
    }

    .content-section .cta-button {
        margin-top: 1rem;
    }

    .body-text {
        font-size: clamp(0.95rem, 1rem + 0.2vw, 1.125rem);
        line-height: 1.75; /* improve readability for long lines */
        color: var(--color-muted);
        margin-bottom: 2.5rem;
        letter-spacing: 0.01em;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
        padding: 0 2rem;
        text-align: left;
    }

    @media (max-width: 900px) {
        .body-text {
            font-size: 1.0625rem;
        }
    }

    @media (max-width: 600px) {
        .body-text {
            font-size: 1rem;
            margin-bottom: 2rem;
        }
    }

    @media (max-width: 400px) {
        .body-text {
            font-size: 0.9375rem;
        }
    }

    .section-title + .body-text {
        margin-top: 5rem;
    }

    .subsection-title + .body-text {
        margin-top: 0;
    }

    /* MDX Content Styles */
    .body-text :global(h3) {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-text);
        margin-top: 3rem;
        margin-bottom: 1rem;
        text-align: left;
    }

    .body-text :global(p) {
        margin-bottom: 1rem;
    }

    .body-text :global(p:last-child) {
        margin-bottom: 0;
    }

    .body-text :global(strong) {
        font-weight: 700;
    }

    .body-text :global(em) {
        font-style: italic;
    }

    .body-text :global(br) {
        display: block;
        content: "";
        margin-top: 0.5rem;
    }

    /* Footer */
    .footer {
        background: transparent;
        padding: 0;
        text-align: center;
    }

    .footer-logo {
        width: 100%;
        max-width: 600px;
        height: auto;
        margin: 0 auto;
        display: block;
        opacity: 0.8;
        mix-blend-mode: color-burn;
    }

    @media (max-width: 600px) {
        .footer-logo {
            max-width: 90%;
        }
    }
</style>
